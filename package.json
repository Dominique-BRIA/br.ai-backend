{
  "name": "br-ia-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Serveur <br/> : API, temps réel, agents et base de données",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "node scripts/build.mjs",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "admin:ajouter": "node --env-file-if-exists=.env scripts/admin-ajouter.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@br-ia/protocol": "*",
    "@electric-sql/pglite": "^0.5.14",
    "@fastify/websocket": "^11.3.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "ws": "^8.22.1"
  }
}
