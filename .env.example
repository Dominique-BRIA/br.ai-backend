# Copier ce fichier en .env pour le développement local.
HOST=127.0.0.1
PORT=4000
# Dossier de la base PGlite locale (aucune installation de PostgreSQL nécessaire).
PGLITE_DIR=.data/pglite
# En production (NODE_ENV=production), base PostgreSQL Neon : adresse avec pooler, puis connexion directe
# pour les migrations. En développement, ces deux variables sont ignorées et PGlite est utilisée.
# DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_DIRECT=postgresql://utilisateur:motdepasse@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Jeton des routes d administration (16 caractères minimum). Facultatif.
# ADMIN_TOKEN=
# Clé Resend pour envoyer les e-mails. Sans elle, les codes sont écrits dans le journal.
# RESEND_API_KEY=
# MAIL_FROM=‹br/› <onboarding@resend.dev>
# Backblaze B2 pour les pièces jointes (facultatif : sans ces variables, les fichiers vont dans FILES_DIR).
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=
# B2_ENDPOINT=https://s3.<region>.backblazeb2.com

# Clés des fournisseurs d IA (offres gratuites). Sans clé, l agent serveur est désactivé.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# ZAI_API_KEY=
# Ordre d essai des modèles du serveur (fournisseur:modèle, séparés par des virgules).
# AI_SERVEUR_CHAIN=gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,groq:openai/gpt-oss-120b,gemini:gemini-flash-lite-latest,zai:glm-4.5-flash
# Ordre d essai des modèles du cuisinier (ils doivent savoir appeler des outils).
# AI_CUISINIER_CHAIN=gemini:gemini-3.6-flash,mistral:codestral-latest,groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash,zai:glm-4.7-flash,zai:glm-4.5-flash

# Clé maîtresse du coffre de secrets : 32 octets en base64. Sans elle, le coffre est fermé.
# Pour en créer une : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ne la changez pas sans rechiffrer les secrets : les anciens deviendraient illisibles.
# SECRETS_KEY=
